---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import Hero from "../components/hero/Hero.astro";
import ProjectSection from "../components/project/ProjectSection.astro";

const projects = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order
);
---

<Base
  title="Rishabh Singh Kushwaha"
  description="Backend engineer. A real-time motion-planning stack for unstructured Indian roads, and a clinical decision-support system whose safety path never depends on model output."
>
  <Hero />

  <main class="shell">
    {projects.map((entry, i) => <ProjectSection entry={entry} index={i + 1} />)}

    <section class="pending">
      <p class="eyebrow">Next</p>
      <h2>Brahmo and winter-chat</h2>
      <p>
        Both land here as sections in the same shape — a markdown file each, no
        component work. Then the stack, the writing placeholder and the footer
        wordmark.
      </p>
    </section>
  </main>
</Base>

<style>
  main {
    padding-bottom: clamp(60px, 12vh, 140px);
  }
  .pending {
    border-top: 1px solid var(--rule);
    padding-top: clamp(40px, 8vh, 80px);
  }
  .pending h2 {
    margin-bottom: 12px;
  }
</style>
