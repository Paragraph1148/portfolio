---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import Hero from "../components/hero/Hero.astro";
import ProjectSection from "../components/project/ProjectSection.astro";
import Stack from "../components/Stack.astro";
import Writing from "../components/Writing.astro";
import Footer from "../components/Footer.astro";

const projects = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order
);
---

<Base
  title="Rishabh Singh Kushwaha"
  description="Backend engineer. A real-time motion-planning stack for unstructured Indian roads that never reads a lane marking — a corridor solver, a harm-weighted risk field, and the benchmark harness behind every number claimed."
>
  <Hero />

  <main class="shell">
    {projects.map((entry, i) => <ProjectSection entry={entry} index={i + 1} />)}

    <Stack />
    <Writing />
  </main>

  <Footer />
</Base>
