---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import Hero from "../components/hero/Hero.astro";
import ProjectSection from "../components/project/ProjectSection.astro";
import Stack from "../components/Stack.astro";
import Writing from "../components/Writing.astro";
import Footer from "../components/Footer.astro";

const projects = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order
);
---

<Base
  title="Rishabh Singh Kushwaha"
  description="Backend engineer. A real-time motion-planning stack for unstructured Indian roads, and a clinical decision-support system whose safety path never depends on model output."
>
  <Hero />

  <main class="shell">
    {projects.map((entry, i) => <ProjectSection entry={entry} index={i + 1} />)}

    <section class="pending">
      <p class="eyebrow">Also</p>
      <h2>Brahmo and winter-chat</h2>
      <p>
        Both land here in the same shape — a markdown file each, no component
        work.
      </p>
    </section>

    <Stack />
    <Writing />
  </main>

  <Footer />
</Base>

<style>
  .pending {
    border-top: 1px solid var(--rule);
    padding-block: clamp(50px, 9vh, 100px);
  }
  .pending h2 {
    margin-bottom: 12px;
  }
  .pending p {
    color: var(--legend-dim);
  }
</style>
