---
/**
 * Socials are marks, not words, as asked. GitHub and LinkedIn use their
 * real filled silhouettes; LeetCode and mail are drawn as strokes at a
 * matched weight, because LeetCode's own mark is stroke-built and a bad
 * filled approximation of it reads worse than an honest geometric one.
 *
 * /resume.pdf is deliberately NOT in public/ — Caddy serves it from a
 * path outside the build output so `rsync --delete` on deploy cannot
 * wipe it and updating is one scp. See docs/deploy.md. It 404s in local
 * dev, which is the correct tradeoff.
 */
const socials = [
  { label: "GitHub", href: "https://github.com/paragraph1148", icon: "github" },
  { label: "LinkedIn", href: "https://linkedin.com/in/rishabh-sk", icon: "linkedin" },
  { label: "LeetCode", href: "https://leetcode.com/u/importer", icon: "leetcode" },
  { label: "Email", href: "mailto:rishabh311002@gmail.com", icon: "mail" },
];
const year = new Date().getFullYear();
---

<footer class="foot">
  <div class="shell">
    <div class="foot__top">
      <div class="foot__say">
        <p class="foot__lede">
          Open to backend and systems roles — India or remote. The fastest way to
          judge the work is to open the planner and interfere with it while it
          drives.
        </p>
        <div class="foot__actions">
          <a class="cap foot__resume is-accent" href="/resume.pdf" download>
            Resume <span class="foot__ext">PDF</span>
          </a>
          <a class="cap foot__resume" href="https://sarathi.rishabhkushwaha.com/" rel="noopener">
            Run SARATHI <span class="foot__ext">Live</span>
          </a>
        </div>
      </div>

      <nav class="foot__social" aria-label="Elsewhere">
        {
          socials.map((s) => (
            <a class="key foot__icon" href={s.href} rel="noopener" aria-label={s.label} title={s.label}>
              {s.icon === "github" && (
                <svg viewBox="0 0 24 24" width="19" height="19" aria-hidden="true">
                  <path
                    fill="currentColor"
                    d="M12 .5C5.73.5.7 5.53.7 11.8c0 4.99 3.24 9.22 7.73 10.72.57.1.78-.24.78-.55v-2.1c-3.14.68-3.81-1.34-3.81-1.34-.52-1.31-1.27-1.66-1.27-1.66-1.03-.7.08-.69.08-.69 1.14.08 1.74 1.17 1.74 1.17 1.01 1.74 2.66 1.24 3.31.95.1-.74.4-1.24.72-1.53-2.51-.28-5.15-1.25-5.15-5.58 0-1.23.44-2.24 1.16-3.03-.12-.29-.5-1.44.11-3 0 0 .95-.3 3.11 1.16a10.8 10.8 0 0 1 5.67 0c2.16-1.46 3.1-1.16 3.1-1.16.62 1.56.23 2.71.12 3 .72.79 1.16 1.8 1.16 3.03 0 4.34-2.65 5.3-5.17 5.57.41.35.77 1.04.77 2.1v3.11c0 .31.2.66.79.55A11.31 11.31 0 0 0 23.3 11.8C23.3 5.53 18.27.5 12 .5Z"
                  />
                </svg>
              )}
              {s.icon === "linkedin" && (
                <svg viewBox="0 0 24 24" width="19" height="19" aria-hidden="true">
                  <path
                    fill="currentColor"
                    d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05a3.74 3.74 0 0 1 3.37-1.85c3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.07 2.07 0 1 1 0-4.13 2.07 2.07 0 0 1 0 4.13ZM7.12 20.45H3.55V9h3.57v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.72v20.55C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.72C24 .77 23.2 0 22.22 0Z"
                  />
                </svg>
              )}
              {s.icon === "leetcode" && (
                <svg viewBox="0 0 24 24" width="19" height="19" aria-hidden="true" fill="none"
                  stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  {/* bar starts clear of the chevron — overlapping it reads as a euro sign at 19px */}
                  <path d="M15 4.3 8.1 11.5a3.3 3.3 0 0 0 0 4.7l3 3a3.3 3.3 0 0 0 4.7 0l1.3-1.3" />
                  <path d="M12.7 13.8h7.4" />
                  <path d="m15 4.3 2.8 2.8" />
                </svg>
              )}
              {s.icon === "mail" && (
                <svg viewBox="0 0 24 24" width="19" height="19" aria-hidden="true" fill="none"
                  stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="2.5" y="4.5" width="19" height="15" rx="2.5" />
                  <path d="m3.4 6.6 7.3 5.5a2.2 2.2 0 0 0 2.6 0l7.3-5.5" />
                </svg>
              )}
            </a>
          ))
        }
      </nav>
    </div>

    <h2 class="wordmark" data-glimmer>
      <span class="wordmark__base">RISHABH</span>
      <span class="wordmark__lit" aria-hidden="true">RISHABH</span>
    </h2>

    <div class="foot__colophon">
      <span>© {year} Rishabh Singh Kushwaha</span>
      <span class="foot__kana">リシャブ · クシュワハ</span>
      <span>Astro · three.js · IBM Plex</span>
    </div>
  </div>
</footer>

<style>
  .foot {
    border-top: 1px solid var(--rule);
    padding-top: clamp(40px, 8vh, 76px);
  }

  .foot__top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 30px;
    flex-wrap: wrap;
    margin-bottom: clamp(38px, 7vh, 70px);
  }

  .foot__lede {
    font-family: var(--sans);
    font-size: var(--step-2);
    line-height: 1.5;
    max-width: 42ch;
    margin: 0 0 20px;
  }

  .foot__actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }
  .foot__resume {
    display: inline-flex;
    align-items: baseline;
    gap: 10px;
    padding: 12px 17px;
    font-family: var(--mono);
    font-size: var(--step-0);
    font-weight: 500;
    text-decoration: none;
    color: var(--legend);
  }
  .foot__resume.is-accent {
    color: var(--accent-legend);
  }
  .foot__ext {
    font-size: var(--step--1);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0.65;
  }

  .foot__social {
    display: flex;
    gap: 10px;
  }
  .foot__icon {
    width: 42px;
    height: 42px;
    display: grid;
    place-items: center;
    color: var(--legend-dim);
    transition: color 0.16s ease, transform 0.16s cubic-bezier(0.2, 0.8, 0.3, 1),
      box-shadow 0.16s cubic-bezier(0.2, 0.8, 0.3, 1);
  }
  .foot__icon:hover {
    color: var(--legend);
  }

  /* ── the backlit wordmark ───────────────────────────────────────
     Two layers: a dim base and a lit copy on top whose opacity is the
     only thing that animates. Releasing the pointer therefore lets the
     glimmer die where it stands instead of snapping back to centre. */
  .wordmark {
    position: relative;
    font-family: var(--mono);
    font-weight: 600;
    font-size: clamp(3rem, 15.5vw, 11.5rem);
    letter-spacing: -0.055em;
    line-height: 0.86;
    margin: 0;
    cursor: default;
    user-select: none;
  }
  .wordmark span {
    display: block;
  }
  .wordmark__base {
    color: var(--wordmark-dim);
  }
  .wordmark__lit {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      30% 120% at var(--mx, 28%) var(--my, 46%),
      var(--legend) 0%,
      transparent 62%
    );
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    opacity: 0.4;
    transition: opacity 1.2s cubic-bezier(0.25, 0.75, 0.35, 1);
  }
  .wordmark:hover .wordmark__lit {
    opacity: 1;
    transition-duration: 0.16s;
  }

  .foot__colophon {
    display: flex;
    justify-content: space-between;
    gap: 14px 26px;
    flex-wrap: wrap;
    padding: 16px 0 clamp(30px, 6vh, 54px);
    font-size: var(--step--1);
    color: var(--legend-dim);
  }
  .foot__kana {
    font-family: var(--kana);
    letter-spacing: 0.22em;
    color: var(--legend-faint);
  }

  @media (max-width: 720px) {
    .foot__top {
      flex-direction: column;
    }
  }
</style>
